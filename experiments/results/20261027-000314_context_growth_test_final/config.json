{
  "experiment": "context_growth",
  "split": "test",
  "scenarios": [
    "P1",
    "P2",
    "P3",
    "P5",
    "P6"
  ],
  "conditions": {
    "baseline_mamba_768": {
      "kind": "baseline",
      "budget": 768,
      "note": "frozen Mamba, top-ranked candidate, no retrieval, no verification"
    },
    "baseline_mamba_2048": {
      "kind": "baseline",
      "budget": 2048,
      "note": "same, 2048-token window"
    },
    "retrieval_always": {
      "kind": "agent",
      "mode": "always",
      "verify": true
    },
    "agentmamba": {
      "kind": "agent",
      "mode": "conditional",
      "verify": true,
      "note": "proposed system"
    },
    "agentmamba_no_verification": {
      "kind": "agent",
      "mode": "conditional",
      "verify": false
    },
    "agentmamba_no_retrieval": {
      "kind": "agent",
      "mode": "never",
      "verify": true
    },
    "agentmamba_vector_only": {
      "kind": "agent",
      "mode": "conditional",
      "verify": true,
      "channels": [
        "vector"
      ],
      "stages": [
        4
      ]
    },
    "agentmamba_lexical_only": {
      "kind": "agent",
      "mode": "conditional",
      "verify": true,
      "channels": [
        "relationship",
        "text"
      ],
      "stages": [
        4
      ]
    }
  },
  "answerer": "mamba",
  "benchmark": {
    "benchmark": "logbench-v1",
    "seed": 2026,
    "synthetic": true,
    "splits": {
      "dev": [
        "P4",
        "P7",
        "P8"
      ],
      "test": [
        "P1",
        "P2",
        "P3",
        "P5",
        "P6"
      ]
    },
    "n_questions": {
      "dev": 45,
      "test": 75
    },
    "note": "Fictional data imitating operational log formats. Not plant data."
  },
  "initial_context": {
    "policy": "most recent arrivals (whole records) within a token budget, question-independent",
    "token_budget": 768
  },
  "config": {
    "seed": 13,
    "paths": {
      "data_dir": "data",
      "synthetic_dir": "data/synthetic",
      "processed_dir": "data/processed",
      "artifacts_dir": "artifacts",
      "storage_dir": "storage",
      "results_dir": "experiments/results",
      "feature_cache": "artifacts/features"
    },
    "models": {
      "mamba_id": "state-spaces/mamba-130m-hf",
      "mamba_max_tokens": 768,
      "mamba_feature_max_tokens": 96,
      "mamba_threads": 6,
      "embedding_id": "sentence-transformers/all-MiniLM-L6-v2",
      "embedding_dim": 384,
      "answerer": "mamba"
    },
    "synthetic": {
      "n_campaigns": 30,
      "heats_per_campaign": 48,
      "ladles_per_campaign": 6,
      "splits": {
        "train": 16,
        "val": 6,
        "test": 8
      },
      "noise_logs_per_heat": 4
    },
    "gate": {
      "model": "logreg",
      "use_mamba_features": true,
      "embedding_pca_dims": 16,
      "mamba_pca_dims": 16,
      "novelty_window": 256,
      "artifact_dir": "artifacts/gate"
    },
    "memory": {
      "budget_fraction": 0.1,
      "budget_unit": "bytes",
      "app_budget_bytes": 400000,
      "policy": "learned"
    },
    "retrieval": {
      "top_k": 8,
      "oversample": 4,
      "expansion_depth": 3,
      "max_expansion_nodes": 60,
      "rerank": true,
      "w_similarity": 1.0,
      "w_path": 0.35,
      "w_type": 0.25
    },
    "controller": {
      "return_threshold": 0.75,
      "post_retrieval_threshold": 0.75
    },
    "verification": {
      "enabled": true
    }
  },
  "environment": {
    "python": "3.11.9",
    "platform": "Windows-10-10.0.26200-SP0",
    "processor": "Intel64 Family 6 Model 186 Stepping 2, GenuineIntel",
    "timestamp_utc": "2026-10-26T18:33:28+00:00",
    "torch": "2.8.0+cpu",
    "transformers": "5.20.2",
    "sentence_transformers": "6.1.0",
    "faiss": "1.15.1",
    "sklearn": "1.9.1",
    "numpy": "1.26.4"
  },
  "models": {
    "mamba": "state-spaces/mamba-130m-hf",
    "embedding": "sentence-transformers/all-MiniLM-L6-v2",
    "precision": "float32 (CPU)",
    "generation": "none: candidate ranking by mean token log-prob (no sampling)"
  },
  "store_policy": "store_all (memory gate not applied; it is not validated on log records)",
