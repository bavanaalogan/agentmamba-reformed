{
  "experiment": "ladle_eval",
  "datasets": [
    "short",
    "long"
  ],
  "answerer": "mamba",
  "window_tokens": 2048,
  "score_cache": false,
  "store_policy": "store_all",
  "models": {
    "mamba": "state-spaces/mamba-130m-hf",
    "embedding": "sentence-transformers/all-MiniLM-L6-v2"
  },
  "environment": {
    "python": "3.11.9",
    "platform": "Windows-10-10.0.26300-SP0",
    "processor": "Intel64 Family 6 Model 186 Stepping 2, GenuineIntel",
    "timestamp_utc": "2026-11-13T06:32:58+00:00",
    "torch": "2.8.0+cpu",
    "transformers": "5.20.2",
    "sentence_transformers": "6.1.0",
    "faiss": "1.15.1",
    "sklearn": "1.9.1",
    "numpy": "1.26.4"
  },
  "config": {
    "seed": 13,
    "paths": {
      "data_dir": "data",
      "synthetic_dir": "data/synthetic",
      "processed_dir": "data/processed",
      "artifacts_dir": "artifacts",
      "storage_dir": "storage",
      "results_dir": "experiments/results",
      "feature_cache": "artifacts/features"
    },
    "models": {
      "mamba_id": "state-spaces/mamba-130m-hf",
      "mamba_max_tokens": 768,
      "mamba_feature_max_tokens": 96,
      "mamba_threads": 12,
      "embedding_id": "sentence-transformers/all-MiniLM-L6-v2",
      "embedding_dim": 384,
      "answerer": "mamba"
    },
    "synthetic": {
      "n_campaigns": 30,
      "heats_per_campaign": 48,
      "ladles_per_campaign": 6,
      "splits": {
        "train": 16,
        "val": 6,
        "test": 8
      },
      "noise_logs_per_heat": 4
    },
    "gate": {
      "model": "logreg",
      "use_mamba_features": true,
      "embedding_pca_dims": 16,
      "mamba_pca_dims": 16,
      "novelty_window": 256,
      "artifact_dir": "artifacts/gate"
    },
    "memory": {
      "budget_fraction": 0.1,
      "budget_unit": "bytes",
      "app_budget_bytes": 400000,
      "policy": "learned"
    },
    "retrieval": {
      "top_k": 8,
      "oversample": 4,
      "expansion_depth": 3,
      "max_expansion_nodes": 60,
      "rerank": true,
      "w_similarity": 1.0,
      "w_path": 0.35,
      "w_type": 0.25
    },
    "controller": {
      "return_threshold": 0.75,
      "post_retrieval_threshold": 0.75
    },
    "verification": {
      "enabled": true
    },
    "evaluation": {
      "composite": {
        "weights": {
          "answer_quality": 0.4,
          "grounding": 0.3,
          "retrieval": 0.15,
          "efficiency": 0.15
        },
        "latency_reference_s": 10.0
      }
    }
  }
}